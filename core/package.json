{
  "name": "organic-mindmap",
  "version": "0.2.0",
  "description": "Hand-drawn-feeling mindmap library: framework-free core with a thin React wrapper.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "prepare": "node scripts/install-browsers.mjs",
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --config bench/vitest.bench.config.ts",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
