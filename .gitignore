# Unanchored on purpose: build and test outputs land inside each workspace package (e.g. core/dist/).
node_modules/
.worktree/
.out/
.tmp/
dist/
test-results/
playwright-report/
dist-demo/
coverage/
# Obsidian plugin: the repo root is the plugin folder. main.js and styles.css are build outputs; data.json is what Obsidian
# saves for the plugin when a vault links this folder. The local dev vault is seeded by
# obsidian-plugin/scripts/setup-dev-vault.sh.
/main.js
/styles.css
/data.json
.dev-vault/
